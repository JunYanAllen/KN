    "shots": "node tools/shoot.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.0",
    "playwright": "^1.50.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
